{{!
    @template block_moodle_proctor/status
}}
<div class="block-moodle-proctor-status">
    <h6 class="h6">{{#str}} status_heading, block_moodle_proctor {{/str}}</h6>
    <ul class="list-unstyled mb-2">
        <li>
            {{#storageok}}
                <span class="text-success">●</span> {{#str}} storage_ready, block_moodle_proctor {{/str}}
            {{/storageok}}
            {{^storageok}}
                <span class="text-danger">●</span> {{#str}} storage_notready, block_moodle_proctor {{/str}}
            {{/storageok}}
        </li>
        {{#requireenrollment}}
        <li>
            {{#complete}}
                <span class="text-success">●</span> {{#str}} enrollment_complete, block_moodle_proctor {{/str}}
            {{/complete}}
            {{^complete}}
                <span class="text-warning">●</span> {{#str}} enrollment_pending, block_moodle_proctor {{/str}}
            {{/complete}}
        </li>
        {{/requireenrollment}}
        {{#enableextension}}
        <li>
            <span class="text-info">●</span> {{#str}} extension_required, block_moodle_proctor {{/str}}
        </li>
        {{/enableextension}}
    </ul>

    {{#requireenrollment}}
    {{^complete}}
    <p class="small text-muted mb-2">{{#str}} enrollment_pending_help, block_moodle_proctor {{/str}}</p>
    <a class="btn btn-primary btn-sm mb-2" href="{{{enrollmenturl}}}">{{#str}} enrollment_link, block_moodle_proctor {{/str}}</a>
    {{/complete}}
    {{/requireenrollment}}

    {{#enableextension}}
    <a class="btn btn-outline-secondary btn-sm mb-2" href="{{{extensioninstallurl}}}">{{#str}} extension_install_link, block_moodle_proctor {{/str}}</a>
    {{/enableextension}}

    {{#canreports}}
    <hr class="my-2">
    <p class="small fw-bold mb-1">{{#str}} staff_tools_heading, block_moodle_proctor {{/str}}</p>
    {{#canmanage}}
    <a class="btn btn-outline-primary btn-sm me-1 mb-1" href="{{{sandboxurl}}}">{{#str}} sandbox_link, block_moodle_proctor {{/str}}</a>
    {{/canmanage}}
    <a class="btn btn-outline-secondary btn-sm me-1 mb-1" href="{{{reportsurl}}}">{{#str}} reports_link, block_moodle_proctor {{/str}}</a>
    <a class="btn btn-outline-secondary btn-sm mb-1" href="{{{identityreporturl}}}">{{#str}} identity_report_link, block_moodle_proctor {{/str}}</a>
    {{/canreports}}
</div>
